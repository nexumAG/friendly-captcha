---
import CaptchaForm from "../components/CaptchaForm.tsx";

const sitekey = import.meta.env.PUBLIC_FRC_SITEKEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@nexumag/friendly-captcha · Astro example</title>
  </head>
  <body>
    <main class="page">
      <section class="card">
        <header class="card__header">
          <img
            class="card__logo"
            src="https://avatars.githubusercontent.com/u/2322771?s=200&v=4"
            width="44"
            height="44"
            alt="nexum"
          />
          <h1 class="card__title">Friendly Captcha for React</h1>
          <p class="card__subtitle">
            A demo of <code>@nexumag/friendly-captcha</code>. The widget below is verified
            server-side by an Astro Action.
          </p>
        </header>

        {
          sitekey ? (
            <CaptchaForm client:load sitekey={sitekey} />
          ) : (
            <p class="status status--error">
              Set <code>PUBLIC_FRC_SITEKEY</code> and <code>FRC_API_KEY</code> in{" "}
              <code>.env</code> — see <code>.env.example</code>.
            </p>
          )
        }

        <footer class="card__footer">
          <a href="https://developer.friendlycaptcha.com/docs/v2" target="_blank" rel="noreferrer">
            Friendly Captcha v2 docs ↗
          </a>
        </footer>
      </section>
    </main>

    <style is:global>
      :root {
        color-scheme: light dark;

        --bg: #f4f5f7;
        --bg-accent: #e9ebf0;
        --surface: #ffffff;
        --border: #e3e6ec;
        --text: #1c2024;
        --text-muted: #6b7280;
        --accent: #4f46e5;
        --accent-hover: #4338ca;
        --accent-contrast: #ffffff;
        --ok-bg: #e7f6ec;
        --ok-text: #1a7f43;
        --error-bg: #fdecec;
        --error-text: #c0392b;
        --code-bg: rgba(15, 23, 42, 0.06);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e1116;
          --bg-accent: #161b22;
          --surface: #171b21;
          --border: #2a2f37;
          --text: #e6e8eb;
          --text-muted: #9aa3af;
          --accent: #6366f1;
          --accent-hover: #818cf8;
          --ok-bg: rgba(34, 197, 94, 0.14);
          --ok-text: #4ade80;
          --error-bg: rgba(239, 68, 68, 0.14);
          --error-text: #f87171;
          --code-bg: rgba(255, 255, 255, 0.08);
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        color: var(--text);
        background:
          radial-gradient(1200px 600px at 50% -10%, var(--bg-accent), transparent 70%),
          var(--bg);
      }

      .page {
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .card {
        width: 100%;
        max-width: 26rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(15, 23, 42, 0.08);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .card__header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .card__logo {
        border-radius: 10px;
      }

      .card__title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .card__subtitle {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--text-muted);
      }

      code {
        font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, monospace;
        font-size: 0.85em;
        background: var(--code-bg);
        padding: 0.1rem 0.35rem;
        border-radius: 5px;
      }

      /* React island: form, button, status */
      .captcha-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: stretch;
      }

      .captcha-form button {
        appearance: none;
        border: none;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--accent-contrast);
        background: var(--accent);
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.05s ease;
      }

      .captcha-form button:hover:not(:disabled) {
        background: var(--accent-hover);
      }

      .captcha-form button:active:not(:disabled) {
        transform: translateY(1px);
      }

      .captcha-form button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.45;
        padding: 0.65rem 0.8rem;
        border-radius: 10px;
      }

      .status.ok,
      .status--ok {
        background: var(--ok-bg);
        color: var(--ok-text);
      }

      .status.error,
      .status--error {
        background: var(--error-bg);
        color: var(--error-text);
      }

      .card__footer {
        font-size: 0.85rem;
        text-align: center;
      }

      .card__footer a {
        color: var(--text-muted);
        text-decoration: none;
      }

      .card__footer a:hover {
        color: var(--text);
        text-decoration: underline;
      }
    </style>
  </body>
</html>
