---
import CaptchaForm from "../components/CaptchaForm.tsx";

const sitekey = import.meta.env.PUBLIC_FRC_SITEKEY;
const apiEndpoint = import.meta.env.FRC_ENDPOINT ?? "global";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@nexum-ag/friendly-captcha · Astro example</title>
    <script is:inline>
      // Set the initial theme before paint to avoid a flash; the React island
      // takes over once it hydrates.
      document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    </script>
  </head>
  <body>
    <main class="page">
      <section class="card">
        <header class="card__header">
          <img
            class="card__logo"
            src="https://avatars.githubusercontent.com/u/2322771?s=200&v=4"
            width="44"
            height="44"
            alt="nexum"
          />
          <h1 class="card__title">Friendly Captcha for React</h1>
          <p class="card__subtitle">
            A form protected by Friendly Captcha and verified on the server by an Astro
            Action. Change the widget's props in the panel at the top.
          </p>
        </header>

        {
          sitekey ? (
            <CaptchaForm client:load sitekey={sitekey} apiEndpoint={apiEndpoint} />
          ) : (
            <p class="status status--error">
              Set <code>PUBLIC_FRC_SITEKEY</code> and <code>FRC_API_KEY</code> in{" "}
              <code>.env</code> — see <code>.env.example</code>.
            </p>
          )
        }

        <footer class="card__footer">
          <a href="https://developer.friendlycaptcha.com/docs/v2" target="_blank" rel="noreferrer">
            Friendly Captcha v2 docs ↗
          </a>
        </footer>
      </section>
    </main>

    <style is:global>
      :root {
        color-scheme: light dark;

        --bg: #f4f5f7;
        --bg-accent: #e9ebf0;
        --surface: #ffffff;
        --border: #e3e6ec;
        --text: #1c2024;
        --text-muted: #6b7280;
        --accent: #4f46e5;
        --accent-hover: #4338ca;
        --accent-contrast: #ffffff;
        --ok-bg: #e7f6ec;
        --ok-text: #1a7f43;
        --error-bg: #fdecec;
        --error-text: #c0392b;
        --code-bg: rgba(15, 23, 42, 0.06);
        --mono: ui-monospace, "SF Mono", "Cascadia Code", Menlo, monospace;
      }

      :root[data-theme="dark"] {
        --bg: #0e1116;
        --bg-accent: #161b22;
        --surface: #171b21;
        --border: #2a2f37;
        --text: #e6e8eb;
        --text-muted: #9aa3af;
        --accent: #6366f1;
        --accent-hover: #818cf8;
        --ok-bg: rgba(34, 197, 94, 0.14);
        --ok-text: #4ade80;
        --error-bg: rgba(239, 68, 68, 0.14);
        --error-text: #f87171;
        --code-bg: rgba(255, 255, 255, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          Roboto,
          sans-serif;
        color: var(--text);
        background:
          radial-gradient(1200px 600px at 50% -10%, var(--bg-accent), transparent 70%),
          var(--bg);
      }

      .page {
        width: 100%;
        display: flex;
        justify-content: center;
      }

      .card {
        width: 100%;
        max-width: 26rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(15, 23, 42, 0.08);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .card__header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .card__logo {
        border-radius: 10px;
      }

      .card__title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .card__subtitle {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.5;
        color: var(--text-muted);
      }

      code {
        font-family: var(--mono);
        font-size: 0.85em;
        background: var(--code-bg);
        padding: 0.1rem 0.35rem;
        border-radius: 5px;
      }

      .props-panel {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 10;
        width: min(22rem, calc(100vw - 2rem));
        max-height: calc(100dvh - 2rem);
        overflow: auto;
        font-family: var(--mono);
        font-size: 0.8rem;
        line-height: 1.65;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
      }

      .props-panel summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 0.9rem;
        cursor: pointer;
        list-style: none;
      }

      .props-panel summary::-webkit-details-marker {
        display: none;
      }

      .props-panel:not([open]) summary .props-panel__tag::after {
        content: " … />";
      }

      .props-panel__body {
        padding: 0 0.9rem 0.8rem;
      }

      .props-panel__body p {
        margin: 0;
      }

      .props-panel__tag {
        color: var(--text-muted);
      }

      .props-panel__body .props-panel__mode {
        margin-top: 0.5rem;
        padding-left: 3ch;
      }

      .prop {
        display: flex;
        align-items: baseline;
        padding-left: 2ch;
      }

      .prop__name {
        color: var(--accent);
      }

      .prop__punct {
        color: var(--text-muted);
      }

      .prop__comment {
        padding-left: 5ch;
        text-indent: -3ch;
        color: var(--text-muted);
      }

      .prop__comment::before {
        content: "// ";
      }

      .prop select,
      .prop button {
        font: inherit;
        color: var(--text);
        background: transparent;
        border: 0;
        border-bottom: 1px dashed var(--accent);
        border-radius: 0;
        padding: 0 0.1rem;
        cursor: pointer;
      }

      .prop select:hover,
      .prop button:hover {
        border-bottom-style: solid;
      }

      .widget-state {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--text-muted);
      }

      .widget-state::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: currentColor;
      }

      .widget-state[data-state="completed"] {
        color: var(--ok-text);
      }

      .widget-state[data-state="error"],
      .widget-state[data-state="expired"] {
        color: var(--error-text);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      @media (max-width: 48rem) {
        body {
          padding-top: 4rem;
        }
      }

      .captcha-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.9rem;
      }

      .field input {
        font: inherit;
        color: var(--text);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
      }

      .captcha-form .frc-captcha {
        transition:
          opacity 0.3s ease,
          height 0.3s ease,
          margin-bottom 0.3s ease;
      }

      @starting-style {
        .captcha-form .frc-captcha {
          opacity: 0;
          height: 0 !important;
          margin-bottom: -1rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .captcha-form .frc-captcha {
          transition: none;
        }
      }

      .attribution {
        margin: 0;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--text-muted);
      }

      .attribution a {
        color: inherit;
      }

      .captcha-form button {
        appearance: none;
        border: none;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--accent-contrast);
        background: var(--accent);
        cursor: pointer;
        transition: background-color 0.15s ease, transform 0.05s ease;
      }

      .captcha-form button:hover:not(:disabled) {
        background: var(--accent-hover);
      }

      .captcha-form button:active:not(:disabled) {
        transform: translateY(1px);
      }

      .captcha-form button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .status {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.45;
        padding: 0.65rem 0.8rem;
        border-radius: 10px;
      }

      .status.ok,
      .status--ok {
        background: var(--ok-bg);
        color: var(--ok-text);
      }

      .status.error,
      .status--error {
        background: var(--error-bg);
        color: var(--error-text);
      }

      .card__footer {
        font-size: 0.85rem;
        text-align: center;
      }

      .card__footer a {
        color: var(--text-muted);
        text-decoration: none;
      }

      .card__footer a:hover {
        color: var(--text);
        text-decoration: underline;
      }
    </style>
  </body>
</html>
