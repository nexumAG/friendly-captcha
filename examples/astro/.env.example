# Server-only secret: your Friendly Captcha API key (sent as the X-API-Key header).
# Never expose this in the browser. Create one in the Friendly Captcha dashboard.
FRC_API_KEY=your_api_key_here

# Optional data residency: "global" (default) or "eu".
FRC_ENDPOINT=global

# Public sitekey used by the widget in the browser (starts with FC...).
PUBLIC_FRC_SITEKEY=FCMxxxxxxxxxxxxxxx
