{
  "name": "@nexum-ag/friendly-captcha",
  "version": "1.0.0-beta.6",
  "description": "Modern, type-safe React bindings for Friendly Captcha v2 — a declarative component, a headless hook, and a runtime-agnostic server-side verification helper.",
  "keywords": [
    "bot-protection",
    "captcha",
    "friendly-captcha",
    "friendlycaptcha",
    "privacy",
    "react",
    "react-hook"
  ],
  "homepage": "https://github.com/nexumAG/friendly-captcha#readme",
  "bugs": "https://github.com/nexumAG/friendly-captcha/issues",
  "license": "Apache-2.0",
  "author": "nexum AG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexumAG/friendly-captcha.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-dts-to-cts.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:pkg": "npm run build && publint && attw --pack --profile node16",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@friendlycaptcha/sdk": "^1.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.58.12",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "publint": "0.3.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup-preserve-directives": "1.1.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
